# ── Data paths ────────────────────────────────────────────────────────────────
# Absolute paths on the host machine to the data files that get bind-mounted
# into the containers at runtime. Never change the right-hand side of the
# volume mounts in docker-compose.yaml — only update these paths.

ATHENA_DB_PATH=/home/bujji/personal-ai-os/agents/athena/tracking/athena.db
GOOGLE_TOKEN_PATH=/home/bujji/personal-ai-os/agents/horus/google_token.json
GOOGLE_SECRET_PATH=/home/bujji/personal-ai-os/agents/horus/google_client_secret.json

# ── Ports ─────────────────────────────────────────────────────────────────────
# Assigned by user — change here only, docker-compose reads these.

FRONTEND_PORT=3001   # browser-facing dashboard
API_PORT=8001        # data API (also accessible directly for debugging)
