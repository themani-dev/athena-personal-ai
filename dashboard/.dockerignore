# Build context excludes
node_modules
.git
.output
dist
*.log
.env

# Never bake secrets into an image even if someone mistakenly drops a
# credentials file inside the repo tree instead of the documented external
# path (~/.config/athena-dashboard/credentials.env).
credentials.env
**/credentials.env
.auth/
**/.auth/

# App-level dev artifacts
app/node_modules
app/.output
app/dist
app/.turbo

# Editor / OS
.DS_Store
.idea
.vscode
*.swp
